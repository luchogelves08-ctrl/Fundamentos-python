def tarifa(tipo):
    if tipo == 1:
        return 3500
    elif tipo == 2:
        return 12000
    elif tipo == 3:
        return 16300


def principal():
    cV = 0
    cC = 0
    cT = 0

    rV = 0
    rC = 0
    rT = 0

    total = 0

    tipo = int(input("Ingrese el tipo de automotor (0 para terminar): "))

    while tipo != 0:
        tipo = int(input("Ingrese el tipo de automotor (0 para terminar): "))

        if tipo >= 1 and tipo <= 3:

            valor = tarifa(tipo)

            print("Valor a pagar: $", valor)

            total = total + valor

            if tipo == 1:
                cV = cV + 1
                rV = rV + valor

            elif tipo == 2:
                cC = cC + 1
                rC = rC + valor

            elif tipo == 3:
                cT = cT + 1
                rT = rT + valor

        else:
            print("Tipo de automotor no valido")

        

    print("\n----- RESULTADOS DEL DIA -----")

    print("Total recaudado: $", total)

    print("Recaudo de vehiculos: $", rV)
    print("Recaudo de camiones: $", rC)
    print("Recaudo de tractomulas: $", rT)

    print("\n----- AUTOMOTOR QUE MAS TRANSITA -----")

    if cV > cC and cV > cT:
        print("Los vehiculos son los que mas transitan")

    elif cC > cV and cC > cT:
        print("Los camiones son los que mas transitan")

    elif cT > cV and cT > cC:
        print("Las tractomulas son las que mas transitan")

    else:
        print("Hay empate entre dos o mas tipos de automotores")


principal()
